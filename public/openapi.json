{
  "openapi": "3.1.0",
  "info": {
    "title": "Photobooth Studio Sanctum API",
    "description": "Dokumentasi OpenAPI Interaktif & Testing Sandbox untuk Aplikasi Mobile Photobooth Studio (Flutter / iOS / Android) terintegrasi Laravel Sanctum.",
    "version": "1.0.0",
    "contact": {
      "name": "Photobooth Studio Dev Team",
      "email": "dev@photobooth.studio"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum Token"
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Autentikasi Aplikasi Mobile & Terbitkan Sanctum Bearer Token",
        "description": "Mengirimkan email dan password untuk mendapatkan Sanctum Bearer Token yang digunakan dalam autentikasi API aplikasi mobile.",
        "operationId": "mobileLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "mobile.dev@photobooth.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password"
                  },
                  "device_name": {
                    "type": "string",
                    "example": "iPhone 15 Pro Flutter Client"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autentikasi Berhasil",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Sanctum bearer token generated successfully",
                  "token": "1|sanctum_bearer_token_abc8891xyz",
                  "user": {
                    "name": "Mobile Developer User",
                    "email": "mobile.dev@photobooth.com",
                    "role": "mobile_client"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/booths": {
      "get": {
        "summary": "Daftar Perangkat Photobooth Aktif",
        "description": "Mengambil daftar seluruh perangkat booth yang tersedia di lokasi event.",
        "operationId": "getBooths",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar Perangkat Booth Berhasil Diambil",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "data": [
                    {
                      "id": "BOOTH-01",
                      "name": "Main Hall Booth",
                      "status": "online",
                      "location": "Zone A"
                    },
                    {
                      "id": "BOOTH-02",
                      "name": "VIP Stage Booth",
                      "status": "online",
                      "location": "Zone B"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sessions/create": {
      "post": {
        "summary": "Memicu Sesi Foto Photobooth via Mobile QR",
        "description": "Memulai sesi pengerjaan photobooth langsung dari aplikasi mobile.",
        "operationId": "createSession",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "booth_id": {
                    "type": "string",
                    "example": "BOOTH-01"
                  },
                  "frame_id": {
                    "type": "string",
                    "example": "cyberpunk-neon-4strip"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesi Berhasil Dibuat",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Photobooth session triggered via Sanctum API",
                  "session_id": "SESH-8891",
                  "qr_code_url": "https://photobooth.studio/share/qr/session8891"
                }
              }
            }
          }
        }
      }
    },
    "/device/pair": {
      "post": {
        "summary": "Pasangkan Perangkat Booth & Terbitkan Device Token",
        "description": "Perangkat booth menggunakan kode pairing (PB-XXXX-XXXX) untuk pairing dan menerima Sanctum token yang diikat ke perangkat. Token memiliki ability device:heartbeat, device:config, dan device:voucher. Status: 422 kode/platfom salah, 403 perangkat dicabut, 409 sudah dipairing.",
        "operationId": "pairDevice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_code": {
                    "type": "string",
                    "example": "PB-K2M7-9QXW"
                  },
                  "platform": {
                    "type": "string",
                    "enum": ["android", "windows"],
                    "example": "android"
                  },
                  "app_version": {
                    "type": "string",
                    "example": "1.2.0"
                  },
                  "device_identifier": {
                    "type": "string",
                    "example": "SN-ABC123"
                  }
                },
                "required": ["device_code", "platform"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pairing Berhasil",
            "content": {
              "application/json": {
                "example": {
                  "message": "Pairing berhasil.",
                  "token": "3|device_token_xyz",
                  "token_type": "Bearer",
                  "device": {
                    "id": 1,
                    "name": "Mall Android Booth",
                    "platform": "android",
                    "pair_status": "paired",
                    "status": "online",
                    "last_seen_at": "2026-09-12T04:00:00+00:00",
                    "app_version": "1.2.0",
                    "project": null
                  }
                }
              }
            }
          }
        }
      }
    },
    "/device/heartbeat": {
      "post": {
        "summary": "Heartbeat Perangkat (Presence & Versi)",
        "description": "Dikirim berkala oleh perangkat untuk memperbarui last_seen_at/status online dan versi aplikasi. Tidak menulis ke riwayat event kecuali versi aplikasi berubah.",
        "operationId": "deviceHeartbeat",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "app_version": {
                    "type": "string",
                    "example": "1.3.1"
                  },
                  "device_identifier": {
                    "type": "string",
                    "example": "SN-ABC123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Heartbeat Diterima",
            "content": {
              "application/json": {
                "example": {
                  "device": {
                    "id": 1,
                    "name": "Mall Android Booth",
                    "platform": "android",
                    "pair_status": "paired",
                    "status": "online",
                    "app_version": "1.3.1",
                    "project": {
                      "id": 2,
                      "name": "Mall Photobox"
                    }
                  },
                  "server_time": "2026-09-12T04:05:00+00:00"
                }
              }
            }
          }
        }
      }
    },
    "/device/config": {
      "get": {
        "summary": "Konfigurasi Runtime Perangkat",
        "description": "Mengambil proyek aktif beserta pengalaman foto (timer, layout, frame, filter, brightness) untuk perangkat. runnable=false saat proyek draf/nonaktif atau belum ditugaskan.",
        "operationId": "deviceConfig",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Konfigurasi Berhasil Diambil",
            "content": {
              "application/json": {
                "example": {
                  "device": {
                    "id": 1,
                    "name": "Mall Android Booth",
                    "platform": "android"
                  },
                  "project": {
                    "id": 2,
                    "name": "Mall Photobox",
                    "type": "retail",
                    "orientation": "portrait",
                    "welcome_image_url": "http://localhost:8000/storage/welcome/mall.jpg",
                    "status": "active",
                    "available": true
                  },
                  "experience": {
                    "timer_seconds": 12,
                    "layout": "grid_4",
                    "frame": "classic",
                    "filter": "bw",
                    "brightness": 15
                  },
                  "runnable": true,
                  "server_time": "2026-09-12T04:05:00+00:00"
                }
              }
            }
          }
        }
      }
    },
    "/voucher/validate": {
      "post": {
        "summary": "Validasi Voucher Perangkat Booth",
        "description": "Memvalidasi kode voucher terhadap perangkat yang sedang assigned ke sebuah proyek. Endpoint ini HANYA mengecek aturan bisnis dan TIDAK melakukan redeem: used_count tidak bertambah, last_used_at tidak diubah, dan tidak ada booth session yang dibuat. Business invalidity dikembalikan dengan HTTP 200 dan reason machine-readable; kegagalan autentikasi tetap 401/403.",
        "operationId": "validateVoucher",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "example": "VCR-7K4F-92QM",
                    "description": "Kode voucher, dinormalisasi otomatis (trim + uppercase) di sisi server."
                  }
                },
                "required": ["code"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hasil validasi (valid atau alasan bisnis tidak valid)",
            "content": {
              "application/json": {
                "examples": {
                  "valid": {
                    "summary": "Voucher valid untuk proyek perangkat",
                    "value": {
                      "valid": true,
                      "voucher": {
                        "code": "VCR-7K4F-92QM",
                        "remaining_uses": 1,
                        "expires_at": "2026-12-31",
                        "project_id": 2
                      },
                      "project": {
                        "id": 2,
                        "name": "Mall Photobox"
                      }
                    }
                  },
                  "invalid": {
                    "summary": "Voucher kadaluarsa",
                    "value": {
                      "valid": false,
                      "reason": "expired"
                    }
                  },
                  "notFound": {
                    "summary": "Kode tidak ditemukan",
                    "value": {
                      "valid": false,
                      "reason": "not_found"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token tidak ada atau bukan token perangkat"
          },
          "403": {
            "description": "Token tidak memiliki ability device:voucher atau perangkat telah dicabut"
          },
          "422": {
            "description": "Field code wajib diisi"
          }
        }
      }
    },
    "/user": {
      "get": {
        "summary": "Profil Pengguna Terautentikasi",
        "description": "Mengambil detail profil pengguna yang sedang login berdasarkan Bearer Token.",
        "operationId": "getUserProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Detail User Berhasil Diambil",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "user": {
                    "id": 1,
                    "name": "Admin Photobooth Studio",
                    "email": "admin@photobooth.com"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
